# --- core ---
PORT=5000
MONGO_URI=mongodb://localhost:27017/text-to-course
NODE_ENV=development

# --- Auth0 ---
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://text-to-course-api

# --- CORS allowlist for deployed origins (comma-separated) ---
# Localhost is always allowed in dev. Add Vercel/preview URLs here for prod.
# Example: ALLOWED_ORIGINS=https://text-to-course.vercel.app,https://www.example.com
ALLOWED_ORIGINS=

# --- LLM (provider chain, priority order) ---
# Tried left-to-right. On quota error, router auto-falls back to next.
LLM_PROVIDERS=groq,gemini

# Groq (free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides
# GROQ_MODEL_PLANNER=llama-3.1-8b-instant
# GROQ_MODEL_WRITER=llama-3.3-70b-versatile

# Gemini (fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Router behaviour
LLM_MAX_CONCURRENCY=3
LLM_MAX_RETRIES=4
LLM_COOLDOWN_MS=60000

# --- RAG ---
# Embeddings cost Gemini quota. Keep off on free-tier keys.
RAG_ENABLED=false

# --- cache (Upstash Redis recommended for cloud deploy) ---
REDIS_URL=redis://localhost:6379

# --- enrichment ---
YOUTUBE_API_KEY=your_youtube_api_key_here
